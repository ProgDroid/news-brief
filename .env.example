# Copy to .env and fill in values
# Never commit .env to git

# Anthropic API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot credentials
# 1. Message @BotFather on Telegram → /newbot → follow prompts → copy the token
# 2. Message @userinfobot on Telegram to get your chat ID
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=987654321

# --- Optional ---

# Podcast Chroma MCP endpoint (defaults to the hosted Modal URL if unset)
# CHROMA_MCP_URL=https://your-host/mcp

# Self-hosted Nitter base URL for the Twitter/X feeds (@geo_papic, @jacobshap).
# Defaults to http://nitter:8080 — the `nitter` service on the shared Docker
# network, Nitter's default internal port. Override if your instance differs.
# NITTER_BASE_URL=http://nitter:8080

# Trading212 READ-ONLY API key. Enables portfolio-weighted news scoring and
# automatic paper-tracker symbol mapping. No absolute monetary value ever leaves
# the machine — only percentage weights, tickers, and P/L direction reach the prompt.
# T212_API_KEY_ID=
# T212_API_KEY=
# T212_BASE_URL=https://live.trading212.com   # or the demo host

# PolyGram (prediction markets) login. Enables the prediction paper-trading seam
# (Claude matches signals to live markets; read-only — no orders are ever placed).
# Registration is manual/one-time at https://polygram.ink — not done by the app.
# POLYGRAM_EMAIL=
# POLYGRAM_PASSWORD=

# Data root for state, archives and the log file (defaults to /app/logs, the
# container volume). Override for local runs outside Docker, e.g. ./data
# NEWSBRIEF_DATA_DIR=/app/logs

# --- docker-compose deployment ---

# Host uid:gid that OWNS the logs volume — the container runs as this (non-root).
PUID=1000
PGID=1000

# Host path holding persistent state + archives (mounted at /app/logs).
APPDATA_DIR=./appdata

# ── Volume monitor (Phase 5) ──────────────────────────────────────────────────
# VOL_SPIKE_MULT=2.5            # alert when current/trailing-mean >= this
# VOL_TRAILING_N=20             # trailing samples kept per instrument
# VOL_MIN_SAMPLES=5             # warm-up: min prior samples before alerting
# VOL_ALERT_COOLDOWN_HRS=12     # per-instrument re-alert suppression window
# VOL_FLOOR_EQUITY=0            # absolute volume floor (0 = off)
# VOL_FLOOR_CRYPTO=0
# VOL_FLOOR_PREDICTION=0
